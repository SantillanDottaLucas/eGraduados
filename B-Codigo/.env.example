# ==========================================================
# eGraduados - plantilla de configuración
# ==========================================================
# Copiar este archivo como .env y completar los valores reales.
# El .env NO se versiona (está en .gitignore). Esta plantilla sí.
#
# Formato compatible con python-dotenv y con systemd
# EnvironmentFile=: CLAVE=valor, sin "export", comillas dobles
# sólo si el valor contiene espacios.
#
# ESTE ARCHIVO MANDA. Django lo carga siempre con override=True:
# las variables del entorno del proceso (systemd, Docker, consola)
# NO pueden reemplazar lo que dice acá. Todas las claves que
# aparecen abajo son obligatorias: si falta .env o alguna clave,
# el proyecto no arranca (inclusive en tests).
# La base de datos es MySQL fijo: SQLite quedó fuera de soporte
# y la variable DJANGO_DB_ENGINE ya no se usa.

# ----------------------------------------------------------
# Despliegue (sólo Linux)
# ----------------------------------------------------------
# Ruta absoluta del proyecto en el servidor. La usa
# scripts/configurar_despliegue.sh para generar el servicio
# systemd y el virtualhost de Nginx; Django NO la lee en runtime
# (el .env se busca dentro de esta misma carpeta).
# Si se renombra la carpeta: moverla, actualizar este valor y
# volver a ejecutar el script de configuración.
EGRADUADOS_DIR=/srv/egraduados/egraduados

# ----------------------------------------------------------
# Generales
# ----------------------------------------------------------
# 0 en producción, 1 en desarrollo. El secret SIEMPRE se toma de acá.
DJANGO_DEBUG=0

# Generar uno nuevo con:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=cambiar-por-un-secret-aleatorio-de-50-caracteres

# Lista separada por comas. Sin comodines en producción.
DJANGO_ALLOWED_HOSTS=egraduados.unpa.edu.ar,www.egraduados.unpa.edu.ar

# Deben incluir esquema (https://). Separados por comas.
DJANGO_CSRF_TRUSTED_ORIGINS=https://egraduados.unpa.edu.ar

# El admin de Django se usa sólo si se habilita explícitamente.
DJANGO_HABILITAR_ADMIN=0

# ----------------------------------------------------------
# Base de datos (MySQL obligatorio; el motor no se configura)
# ----------------------------------------------------------
# DJANGO_DB_PASSWORD puede quedar vacía, pero la línea debe existir.
DJANGO_DB_NAME=egraduados
DJANGO_DB_USER=egraduados
DJANGO_DB_PASSWORD=cambiar-clave
DJANGO_DB_HOST=127.0.0.1
DJANGO_DB_PORT=3306

# ----------------------------------------------------------
# Seguridad, sesión y límites
# ----------------------------------------------------------
# 8 horas, en segundos.
DJANGO_SESSION_COOKIE_AGE=28800

# Intentos fallidos antes de bloquear el usuario.
DJANGO_LOGIN_MAX_INTENTOS=5

# Segundos de bloqueo tras agotar los intentos.
DJANGO_LOGIN_BLOQUEO_SEGUNDOS=300

# Tamaño máximo de archivos subidos, en bytes (10 MB).
DJANGO_MAX_UPLOAD_SIZE=10485760

# Detrás de un proxy TLS: mantener en 1. Si no hay HTTPS,
# poner en 0 y reducir HSTS (check --deploy avisará).
DJANGO_SECURE_SSL_REDIRECT=1

# Un año, en segundos.
DJANGO_SECURE_HSTS_SECONDS=31536000

# ----------------------------------------------------------
# Correo
# ----------------------------------------------------------
# Por defecto: consola si DJANGO_DEBUG=1, SMTP si DJANGO_DEBUG=0.
# Se puede forzar con DJANGO_EMAIL_BACKEND.
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DJANGO_EMAIL_HOST=smtp.proveedor.com
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=egraduados@unpa.edu.ar
DJANGO_EMAIL_HOST_PASSWORD=cambiar-clave-smtp
DJANGO_EMAIL_USE_TLS=1
# DJANGO_EMAIL_USE_SSL=0    # Mutualmente excluyente con USE_TLS.
DJANGO_DEFAULT_FROM_EMAIL=egraduados@unpa.edu.ar

# ----------------------------------------------------------
# Usuario administrador inicial
# ----------------------------------------------------------
# Los lee `python manage.py crear_usuario_admin` si no se pasan
# --email / --nombre. El código de acceso NO se configura acá: se
# genera al azar, se guarda hasheado y se muestra una sola vez.
# Requiere una cuenta de Gmail (@gmail.com).
EGRADUADOS_ADMIN_EMAIL=admin@gmail.com
EGRADUADOS_ADMIN_NOMBRE=Administrador
